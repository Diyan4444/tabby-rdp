+#[test]
+fn static_channel_refuses_a_message_declared_longer_than_it_takes() {
+    // The first chunk declares the message's length, up to 4 GiB; the chunks would be held until the last one.
+    let mut channel = StaticVirtualChannel::new(RuntimeChannel::new("chunk", ChannelOptions::empty()));
+    assert!(
+        channel
+            .process(&channel_chunk(b"first", u32::MAX, ChannelControlFlags::FLAG_FIRST))
+            .is_err()
+    );
+
+    let longest = u32::try_from(DEFAULT_MAX_MESSAGE_SIZE).expect("the default maximum fits the length field");
+    let mut channel = StaticVirtualChannel::new(RuntimeChannel::new("chunk", ChannelOptions::empty()));
+    assert!(
+        channel
+            .process(&channel_chunk(b"first", longest, ChannelControlFlags::FLAG_FIRST))
+            .is_ok()
+    );
+    let mut channel = StaticVirtualChannel::new(RuntimeChannel::new("chunk", ChannelOptions::empty()));
+    assert!(
+        channel
+            .process(&channel_chunk(b"first", longest + 1, ChannelControlFlags::FLAG_FIRST))
+            .is_err()
+    );
+}
