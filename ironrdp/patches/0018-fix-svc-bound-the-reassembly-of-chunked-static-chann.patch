+/// A channel that takes messages of at most `max_message_size` bytes, and keeps those it is handed.
+#[derive(Debug)]
+struct LimitedChannel {
+    max_message_size: usize,
+    received: Vec<Vec<u8>>,
+}
+
+ironrdp_core::impl_as_any!(LimitedChannel);
+
+impl SvcProcessor for LimitedChannel {
+    fn channel_name(&self) -> ChannelName {
+        ChannelName::from_utf8("limited").expect("valid static channel name")
+    }
+
+    fn max_message_size(&self) -> usize {
+        self.max_message_size
+    }
+
+    fn process(&mut self, payload: &[u8]) -> ironrdp_pdu::PduResult<Vec<SvcMessage>> {
+        self.received.push(payload.to_vec());
+        Ok(Vec::new())
+    }
+}
