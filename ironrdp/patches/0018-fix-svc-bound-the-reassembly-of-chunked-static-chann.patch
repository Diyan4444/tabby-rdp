+#[test]
+fn static_channel_limits_unfragmented_compatibility_messages() {
+    let mut channel = StaticVirtualChannel::new(LimitedChannel {
+        max_message_size: 16,
+        received: Vec::new(),
+    });
+    for flags in [ChannelControlFlags::empty(), ChannelControlFlags::PACKET_COMPRESSED] {
+        assert!(channel.process(&channel_chunk(&[1; 17], 17, flags)).is_err());
+        assert!(channel.process(&channel_chunk(&[1; 17], 16, flags)).is_err());
+        assert!(channel.process(&channel_chunk(&[1; 16], 16, flags)).is_ok());
+    }
+    assert!(
+        channel
+            .process(&channel_chunk(&[1], 17, ChannelControlFlags::PACKET_COMPRESSED))
+            .is_err()
+    );
+}
+
+#[test]
+fn static_channel_takes_messages_up_to_its_processors_maximum() {
+    let mut channel = StaticVirtualChannel::new(LimitedChannel {
+        max_message_size: 16,
+        received: Vec::new(),
+    });
+    let received = |channel: &StaticVirtualChannel| {
+        channel
+            .channel_processor_downcast_ref::<LimitedChannel>()
+            .expect("limited channel")
+            .received
+            .clone()
+    };
+
+    assert!(
+        channel
+            .process(&channel_chunk(&[1; 10], 16, ChannelControlFlags::FLAG_FIRST))
+            .is_ok()
+    );
+    assert!(
+        channel
+            .process(&channel_chunk(&[2; 6], 16, ChannelControlFlags::FLAG_LAST))
+            .is_ok()
+    );
+    assert_eq!(received(&channel), vec![[[1; 10].as_slice(), &[2; 6]].concat()]);
+
+    assert!(
+        channel
+            .process(&channel_chunk(&[3; 10], 17, ChannelControlFlags::FLAG_FIRST))
+            .is_err()
+    );
+
+    // Nor do compressed chunks go past it.
+    let compressed = ChannelControlFlags::PACKET_COMPRESSED;
+    assert!(
+        channel
+            .process(&channel_chunk(
+                &[4; 10],
+                16,
+                ChannelControlFlags::FLAG_FIRST | compressed
+            ))
+            .is_ok()
+    );
+    assert!(channel.process(&channel_chunk(&[5; 10], 16, compressed)).is_err());
+
+    // The refused message is gone; the next one is taken.
+    assert!(
+        channel
+            .process(&channel_chunk(
+                &[6; 16],
+                16,
+                ChannelControlFlags::FLAG_FIRST | ChannelControlFlags::FLAG_LAST
+            ))
+            .is_ok()
+    );
+    assert_eq!(received(&channel).last(), Some(&vec![6; 16]));
+}
+
+#[test]
+fn channels_take_messages_as_long_as_their_protocols_need() {
+    let first_chunk_of = |length: usize| {
+        channel_chunk(
+            b"first",
+            u32::try_from(length).expect("length fits"),
+            ChannelControlFlags::FLAG_FIRST,
+        )
+    };
+    let takes = |processor: StaticVirtualChannel, length: usize| {
+        let mut channel = processor;
+        channel.process(&first_chunk_of(length)).is_ok()
+    };
+
+    // Clipboard data is the copied content itself: a bitmap of two 8K monitors is 253 MiB.
+    let clipboard = || StaticVirtualChannel::new(CliprdrClient::new(Box::new(NoClipboard)));
+    assert!(takes(clipboard(), 15360 * 4320 * 4 + 40));
+    assert!(!takes(clipboard(), 256 * 1024 * 1024 + 1));
+
+    // An RDPSND PDU's BodySize is 16 bits; a DRDYNVC message carries one DVC PDU of at most one chunk.
+    let audio = || StaticVirtualChannel::new(Rdpsnd::new(Box::new(NoopRdpsndBackend)));
+    assert!(takes(audio(), 65_539));
+    assert!(!takes(audio(), 1024 * 1024 + 1));
+    let drdynvc = || StaticVirtualChannel::new(DrdynvcClient::new());
+    assert!(takes(drdynvc(), MAX_CHANNEL_CHUNK_LENGTH));
+    assert!(!takes(drdynvc(), 1024 * 1024 + 1));
+}
