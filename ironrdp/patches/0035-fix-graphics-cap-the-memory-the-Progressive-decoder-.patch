+/// Memory a [`ProgressiveDecoder`] holds for its codec contexts, tiles and sub-band references,
+/// counted against a limit.
+#[derive(Debug)]
+struct MemoryBudget {
+    /// INVARIANT: used <= limit
+    used: usize,
+    limit: usize,
+}
+
+impl MemoryBudget {
+    /// Charges `bytes` more, or fails, changing nothing, if that would go past the limit.
+    fn charge(&mut self, bytes: usize) -> Result<(), ProgressiveDecodeError> {
+        self.replace(0, bytes)
+    }
+
+    /// Releases `released` bytes and charges `charged`, or fails, changing nothing, if that would
+    /// go past the limit.
+    fn replace(&mut self, released: usize, charged: usize) -> Result<(), ProgressiveDecodeError> {
+        match self.used.saturating_sub(released).checked_add(charged) {
+            Some(used) if used <= self.limit => {
+                self.used = used;
+                Ok(())
+            }
+            _ => Err(ProgressiveDecodeError::MemoryLimitExceeded { limit: self.limit }),
+        }
+    }
+
+    fn release(&mut self, bytes: usize) {
+        self.used = self.used.saturating_sub(bytes);
+    }
+}
+
+/// Bytes charged for a sub-band reference: its coefficients, and its entry in the map.
+const REFERENCE_BYTES: usize = size_of::<DecDwtQ>() + size_of::<(SubBandDiffingTileKey, Box<DecDwtQ>)>();
+
+/// Bytes charged for a codec context on top of the size of its map entry and of its grid's slots.
+///
+/// Those sizes leave out what holding them takes: the B-tree nodes of `contexts`, and of
+/// `frame_tiles` while an RDPGFX frame is open, have room for eleven entries and are about half
+/// full, and the grid's allocation takes 16 bytes or more even for one slot. An empty codec
+/// context on a one-tile surface is 48 bytes in size (32 in the WebAssembly build) and takes about
+/// 150 (110): charged their size alone, codec contexts that a server opens with empty payloads
+/// would hold three times the limit by the time they reached it. With 512 bytes more, they hold at
+/// most about a quarter of it. Windows and GNOME Remote Desktop open one or two codec contexts per
+/// surface.
+const CONTEXT_OVERHEAD_BYTES: usize = 512;
+
 /// Per-context progressive state, identified by `(surface_id, codec_context_id)`.
 struct ProgressiveContext {
     surface: SurfaceTiles,
 }
 
+impl ProgressiveContext {
+    /// Bytes charged for a codec context whose tile grid has `tile_count` slots, before any tile
+    /// is filled.
+    fn grid_bytes(tile_count: usize) -> usize {
+        (size_of::<((u16, u32), Self)>() + CONTEXT_OVERHEAD_BYTES)
+            .saturating_add(tile_count.saturating_mul(size_of::<Option<Box<TileState>>>()))
+    }
+
+    /// Bytes charged for this codec context: its tile grid and the tiles filled in it.
+    fn held_bytes(&self) -> usize {
+        let filled_tiles = self.surface.tiles.iter().filter(|tile| tile.is_some()).count();
+        Self::grid_bytes(self.surface.tiles.len()).saturating_add(filled_tiles.saturating_mul(size_of::<TileState>()))
+    }
+}
