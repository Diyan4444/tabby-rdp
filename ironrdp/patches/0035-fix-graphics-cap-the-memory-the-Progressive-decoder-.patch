+/// Stores `coefficients` as a tile's sub-band reference, charging a new one to `memory`.
+fn retain_reference(
+    references: &mut BTreeMap<SubBandDiffingTileKey, Box<DecDwtQ>>,
+    memory: &mut MemoryBudget,
+    key: SubBandDiffingTileKey,
+    coefficients: &DecDwtQ,
+) -> Result<(), ProgressiveDecodeError> {
+    match references.entry(key) {
+        Entry::Occupied(mut entry) => {
+            **entry.get_mut() = *coefficients;
+        }
+        Entry::Vacant(entry) => {
+            memory.charge(REFERENCE_BYTES)?;
+            entry.insert(Box::new(*coefficients));
+        }
+    }
+
+    Ok(())
+}
