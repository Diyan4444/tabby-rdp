+        )
+        .unwrap();
+
+    assert!(
+        matches!(
+            connector.state,
+            ClientConnectorState::MultitransportPending { requests_seen: 1, .. }
+        ),
+        "the multitransport request is surfaced and counted"
+    );
+}
