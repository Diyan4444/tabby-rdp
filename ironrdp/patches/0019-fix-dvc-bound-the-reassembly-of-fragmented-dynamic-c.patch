 use tracing::error;
 
 use crate::pdu::{DataFirstPdu, DataPdu, DrdynvcDataPdu};
@@ -20,62 +20,134 @@ impl CompleteData {
         }
     }
 
-    pub(crate) fn process_data(&mut self, pdu: DrdynvcDataPdu) -> DecodeResult<Option<Vec<u8>>> {
+    /// The declared size of the message being reassembled; 0 when there is none.
+    pub(crate) fn pending_size(&self) -> usize {
+        self.total_size
+    }
+
+    /// Takes a DVC data PDU: returns a whole message, and holds the parts of a fragmented one until it is complete.
+    ///
+    /// No message longer than `max_message_size` is taken, and no fragmented one declared longer than
+    /// `max_pending_size` is held: either is a decode error, and a fragmented message is refused on its first
+    /// fragment, before any of it is held.
+    pub(crate) fn process_data(
+        &mut self,
+        pdu: DrdynvcDataPdu,
+        max_message_size: usize,
+        max_pending_size: usize,
+    ) -> DecodeResult<Option<Vec<u8>>> {
         match pdu {
-            DrdynvcDataPdu::DataFirst(data_first) => self.process_data_first_pdu(data_first),
-            DrdynvcDataPdu::Data(data) => self.process_data_pdu(data),
+            DrdynvcDataPdu::DataFirst(data_first) => {
+                self.process_data_first_pdu(data_first, max_message_size, max_pending_size)
+            }
+            DrdynvcDataPdu::Data(data) => self.process_data_pdu(data, max_message_size),
         }
     }
 
-    fn process_data_first_pdu(&mut self, data_first: DataFirstPdu) -> DecodeResult<Option<Vec<u8>>> {
+    fn process_data_first_pdu(
+        &mut self,
+        data_first: DataFirstPdu,
+        max_message_size: usize,
+        max_pending_size: usize,
+    ) -> DecodeResult<Option<Vec<u8>>> {
         let total_data_size: DecodeResult<_> = cast_length!("DataFirstPdu::length", data_first.length());
         let total_data_size = total_data_size?;
         if self.total_size != 0 || !self.data.is_empty() {
             error!("Incomplete DVC message, it will be skipped");
 
-            self.data.clear();
+            self.clear();
+        }
+
+        // The size is the sender's to declare: a message the channel won't take is refused before any of it is held.
+        if total_data_size > max_message_size {
+            return Err(invalid_field_err!(
+                "DataFirstPdu",
+                "length",
+                "DVC message is longer than the channel takes"
+            ));
         }
 
         if total_data_size == data_first.data().len() {
-            Ok(Some(data_first.into_data()))
-        } else {
-            self.total_size = total_data_size;
-            self.data = data_first.into_data();
+            return Ok(Some(data_first.into_data()));
+        }
+
+        if total_data_size < data_first.data().len() {
+            error!("DVC message is longer than its declared size, it will be skipped");
+            return Ok(None);
+        }
 
-            Ok(None)
+        if total_data_size > max_pending_size {
+            return Err(invalid_field_err!(
+                "DataFirstPdu",
+                "length",
+                "DVC messages being reassembled would be longer together than the channels may hold"
+            ));
         }
+
+        self.total_size = total_data_size;
+        self.data = data_first.into_data();
+
+        Ok(None)
     }
 
-    fn process_data_pdu(&mut self, mut data: DataPdu) -> DecodeResult<Option<Vec<u8>>> {
+    fn process_data_pdu(&mut self, mut data: DataPdu, max_message_size: usize) -> DecodeResult<Option<Vec<u8>>> {
         if self.total_size == 0 && self.data.is_empty() {
             // message is not fragmented
+            if data.data().len() > max_message_size {
+                return Err(invalid_field_err!(
+                    "DataPdu",
+                    "data",
+                    "DVC message is longer than the channel takes"
+                ));
+            }
+
             return Ok(Some(data.into_data()));
         }
 
         // The message is fragmented and needs to be reassembled.
-        match self.data.len().checked_add(data.data().len()) {
-            Some(actual_data_length) => {
-                match actual_data_length.cmp(&(self.total_size)) {
-                    cmp::Ordering::Less => {
-                        // this is one of the fragmented messages, just append it
-                        self.data.append(data.data_mut());
-                        Ok(None)
-                    }
-                    cmp::Ordering::Equal => {
-                        // this is the last fragmented message, need to return the whole reassembled message
-                        self.total_size = 0;
-                        self.data.append(data.data_mut());
-                        Ok(Some(self.data.drain(..).collect()))
-                    }
-                    cmp::Ordering::Greater => {
-                        error!("Actual DVC message size is grater than expected total DVC message size");
-                        self.total_size = 0;
-                        self.data.clear();
-                        Ok(None)
-                    }
-                }
+        let Some(actual_data_length) = self.data.len().checked_add(data.data().len()) else {
+            return Err(invalid_field_err!("DVC message", "data", "overflow occurred"));
+        };
+        if actual_data_length > self.total_size {
+            error!("Actual DVC message size is greater than expected total DVC message size");
+            self.clear();
+            return Ok(None);
+        }
+
+        // Room for the fragment: by doubling, as `Vec` grows, but not past the declared size; and when there is no
+        // memory for it, an error rather than an abort.
+        if actual_data_length > self.data.capacity() {
+            let capacity = self
+                .data
+                .capacity()
+                .saturating_mul(2)
+                .min(self.total_size)
+                .max(actual_data_length);
+            if self
+                .data
+                .try_reserve_exact(capacity.saturating_sub(self.data.len()))
+                .is_err()
+            {
+                self.clear();
+                return Err(other_err!("DVC message", "out of memory for the DVC message"));
             }
-            _ => Err(invalid_field_err!("DVC message", "data", "overflow occurred")),
         }
+
+        self.data.append(data.data_mut());
+
+        if actual_data_length < self.total_size {
+            // this is one of the fragmented messages, just append it
+            return Ok(None);
+        }
+
+        // this is the last fragmented message, need to return the whole reassembled message
+        self.total_size = 0;
+        Ok(Some(mem::take(&mut self.data)))
+    }
+
+    fn clear(&mut self) {
+        // Its memory goes too: the message may have been long.
+        self.total_size = 0;
+        self.data = Vec::new();
     }
 }
diff --git a/crates/ironrdp-dvc/src/lib.rs b/crates/ironrdp-dvc/src/lib.rs
index 7d52c1ae..06af78ea 100644
--- a/crates/ironrdp-dvc/src/lib.rs
+++ b/crates/ironrdp-dvc/src/lib.rs
@@ -38,6 +38,15 @@ pub mod pdu;
 /// sixty-four times the largest chunk.
 const MAX_DRDYNVC_MESSAGE_SIZE: usize = 1024 * 1024;
 
+/// The largest message a dynamic virtual channel takes, once reassembled from its fragments, unless its processor
+/// says otherwise ([`DvcProcessor::max_message_size`]): 64 MiB.
+///
+/// A fragmented message is as long as its DVC Data First PDU declares, up to 4 GiB, and its fragments are held until
+/// it is complete: nothing but this bounds what a peer can make the receiver hold. Channels whose messages can
+/// legitimately be longer (the graphics pipeline's) declare their own maximum, and so can channels whose protocol
+/// bounds them well below.
+pub const DEFAULT_MAX_MESSAGE_SIZE: usize = 64 * 1024 * 1024;
+
 /// Represents a message that, when encoded, forms a complete PDU for a given dynamic virtual channel.
 /// This means a message that is ready to be wrapped in [`pdu::DataFirstPdu`] and [`pdu::DataPdu`] PDUs
 /// (being split into multiple of such PDUs if necessary).
@@ -114,6 +123,15 @@ pub trait DvcProcessor: AsAny + Send {
     fn process(&mut self, channel_id: u32, payload: &[u8]) -> PduResult<Vec<DvcMessage>>;
 
     fn close(&mut self, _channel_id: u32) {}
+
+    /// The largest message this channel takes from its peer, once reassembled from its fragments.
+    ///
+    /// A fragmented message declared longer than this is refused when its first fragment arrives, before any of it is
+    /// held, and so is a whole message longer than this: processing the data fails with a decode error. Defaults to
+    /// [`DEFAULT_MAX_MESSAGE_SIZE`].
+    fn max_message_size(&self) -> usize {
+        DEFAULT_MAX_MESSAGE_SIZE
+    }
 }
 
 assert_obj_safe!(DvcProcessor);
