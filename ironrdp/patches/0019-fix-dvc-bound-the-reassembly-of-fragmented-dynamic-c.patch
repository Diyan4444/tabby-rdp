+impl_as_any!(LimitedDvc);
+
+impl DvcProcessor for LimitedDvc {
+    fn channel_name(&self) -> &str {
+        "limited"
+    }
+
+    fn start(&mut self, _channel_id: u32) -> PduResult<Vec<DvcMessage>> {
+        Ok(Vec::new())
+    }
+
+    fn process(&mut self, _channel_id: u32, payload: &[u8]) -> PduResult<Vec<DvcMessage>> {
+        self.received.push(payload.to_vec());
+        Ok(Vec::new())
+    }
+
+    fn max_message_size(&self) -> usize {
+        self.max_message_size
+    }
+}
+
+impl DvcClientProcessor for LimitedDvc {}
+
+/// Opens a recorded channel for every Create Request, as a listener may.
+struct RecordedListener;
+
+impl DvcChannelListener for RecordedListener {
+    fn channel_name(&self) -> &str {
+        "recorded"
+    }
+
+    fn create(&mut self, _channel_id: u32) -> Option<Box<dyn DvcClientProcessor>> {
+        Some(Box::new(RecordedDvc::default()))
+    }
+}
+
+#[derive(Debug)]
+struct NoGraphics;
+
+impl GraphicsPipelineHandler for NoGraphics {}
+
+fn create_request(channel_id: u32, name: &str) -> Vec<u8> {
+    encode_vec(&DrdynvcServerPdu::Create(CreateRequestPdu::new(
+        channel_id,
+        name.to_owned(),
+    )))
+    .expect("DVC create request should encode")
+}
+
+fn data_first(channel_id: u32, length: u32, data: &[u8]) -> Vec<u8> {
+    encode_vec(&DrdynvcServerPdu::Data(DrdynvcDataPdu::DataFirst(DataFirstPdu::new(
+        channel_id,
+        length,
+        data.to_vec(),
+    ))))
+    .expect("DVC data first should encode")
+}
+
+fn data(channel_id: u32, data: &[u8]) -> Vec<u8> {
+    encode_vec(&DrdynvcServerPdu::Data(DrdynvcDataPdu::Data(DataPdu::new(
+        channel_id,
+        data.to_vec(),
+    ))))
+    .expect("DVC data should encode")
+}
+
+fn mib(n: u32) -> u32 {
+    n * 1024 * 1024
+}
+
+#[test]
+fn fragmented_message_declared_longer_than_the_channel_takes_is_refused() {
+    // The Data First PDU declares the message's length, up to 4 GiB; the fragments would be held until it is complete.
+    let mut client = DrdynvcClient::new();
+    client
+        .attach_established_dynamic_channel(7, RecordedDvc::default())
+        .expect("recorded channel should attach");
+
+    assert!(client.process(&data_first(7, u32::MAX, b"first")).is_err());
+}
+
+#[test]
+fn messages_being_reassembled_on_all_channels_are_bounded_together() {
+    // A listener opens a channel for every Create Request: each one's unfinished message must not add up.
+    let mut client = DrdynvcClient::new().with_listener(RecordedListener);
+    for channel_id in 1..=3 {
+        client
+            .process(&create_request(channel_id, "recorded"))
+            .expect("listener should open the channel");
+    }
+
+    assert!(client.process(&data_first(1, mib(40), b"first")).is_ok());
+    assert!(client.process(&data_first(2, mib(40), b"first")).is_err());
+
+    // A message that completes, or a channel that closes, no longer holds anything.
+    let mut client = DrdynvcClient::new().with_listener(RecordedListener);
+    for channel_id in 1..=3 {
+        client
+            .process(&create_request(channel_id, "recorded"))
+            .expect("listener should open the channel");
+    }
+    assert!(client.process(&data_first(1, 8, b"first")).is_ok());
+    assert!(client.process(&data(1, b"...")).is_ok());
+    assert!(client.process(&data_first(2, mib(40), b"first")).is_ok());
+    let close = encode_vec(&DrdynvcServerPdu::Close(ClosePdu::new(2))).expect("DVC close should encode");
+    assert!(client.process(&close).is_ok());
+    assert!(client.process(&data_first(3, mib(40), b"first")).is_ok());
+}
+
+#[test]
+fn channel_takes_messages_up_to_its_processors_maximum() {
+    let mut client = DrdynvcClient::new();
+    client
+        .attach_established_dynamic_channel(
+            7,
+            LimitedDvc {
+                max_message_size: 16,
+                received: Vec::new(),
+            },
+        )
+        .expect("limited channel should attach");
+    let received = |client: &DrdynvcClient| {
+        client
+            .get_dvc_by_channel_id::<LimitedDvc>(7)
+            .expect("limited channel")
+            .processor()
+            .received
+            .clone()
+    };
+
+    assert!(client.process(&data_first(7, 16, &[1; 10])).is_ok());
+    assert!(client.process(&data(7, &[2; 6])).is_ok());
+    assert_eq!(received(&client), vec![[[1; 10].as_slice(), &[2; 6]].concat()]);
+
+    assert!(client.process(&data_first(7, 17, &[3; 10])).is_err());
+    assert!(client.process(&data(7, &[4; 17])).is_err());
+
+    // The refused messages are gone; the next one is taken.
+    assert!(client.process(&data(7, &[5; 16])).is_ok());
+    assert_eq!(received(&client).last(), Some(&vec![5; 16]));
+}
+
+#[test]
+fn channels_take_messages_as_long_as_their_protocols_need() {
+    let mut client = DrdynvcClient::new()
+        .with_dynamic_channel(GraphicsPipelineClient::new(Box::new(NoGraphics), None))
+        .with_dynamic_channel(DisplayControlClient::new(|_| Ok(Vec::new())));
+    client
+        .process(&create_request(1, ironrdp_egfx::CHANNEL_NAME))
+        .expect("graphics pipeline should open");
+    client
+        .process(&create_request(2, ironrdp_displaycontrol::CHANNEL_NAME))
+        .expect("display control should open");
+
+    // A frame of uncompressed pixels for a surface two 8K monitors wide is 253 MiB.
+    let two_8k_monitors = 15360 * 4320 * 4 + 1024;
+    assert!(two_8k_monitors > DEFAULT_MAX_MESSAGE_SIZE);
+    let two_8k_monitors = u32::try_from(two_8k_monitors).expect("length fits");
+    assert!(client.process(&data_first(1, two_8k_monitors, b"first")).is_ok());
+    assert!(client.process(&data_first(1, mib(256) + 1, b"first")).is_err());
+
+    // The server only sends display control its capabilities.
+    assert!(client.process(&data_first(2, mib(1) + 1, b"first")).is_err());
+}
